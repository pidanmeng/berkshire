/**
 * 四大师投资框架 + 财报精读 — 综合评估脚本
 *
 * 用法：
 *   bun run evaluate.ts --code 600519               # 自动获取数据并输出分析框架
 *   bun run evaluate.ts --code 600519 --peer 000858  # 指定同业对比公司
 *
 * 输出：Markdown 格式的四大师评估 + 财报精读框架，Agent 可基于此填充分析。
 */

import {
  searchTicker,
  getSnapshot,
  getValuations,
  getKline,
  getIncomeStatements,
  getBalanceSheets,
  getCashFlows,
  getIndicators,
  getMarketCapFromEastmoney,
} from "../hithink/hithink.ts";
import { computeComposite } from "../valuation/composite.ts";

export function toThsCode(code: string): string {
  if (code.includes(".")) return code;
  return code.startsWith("6") ? `${code}.SH` : `${code}.SZ`;
}

export function fmtWan(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  if (Math.abs(v) >= 1e8) return (v / 1e8).toFixed(2) + " 亿";
  if (Math.abs(v) >= 1e4) return (v / 1e4).toFixed(2) + " 万";
  return v.toFixed(2);
}

export function fmtPct(v: number | null | undefined): string {
  if (v === null || v === undefined) return "—";
  return (v * 100).toFixed(2) + "%";
}

export function fmtDate(ms: number): string {
  return new Date(ms).toISOString().slice(0, 10);
}

/**
 * 生成星级字符串（1-5星）
 * @param score 0-10 分的评分，会映射到 1-5 星
 * @param useHalfStar 是否启用半星（☆）
 * @returns 星级字符串，如 "★★★★☆" = 4.5 星，"★★★★★" = 5 星
 */
export function toStars(score: number, useHalfStar = true): string {
  // 将 0-10 分映射为 1-5 星（保底 1 星）
  const clamped = Math.max(0, Math.min(10, score));
  const starValue = Math.max(1, (clamped / 10) * 5); // 1-5 范围
  const fullStars = Math.floor(starValue);
  const remainder = starValue - fullStars;
  let result = "★".repeat(fullStars);
  if (useHalfStar && remainder >= 0.5) {
    result += "☆"; // 半星
  } else if (useHalfStar && remainder > 0) {
    // 小于半星补空星占位，保持对齐
    result += "✩";
  }
  // 填充到 5 位
  while (result.replace(/[★☆✩]/g, "").length + result.length < 5) {
    const currentLen = (result.match(/[★☆✩]/g) || []).reduce((acc, ch) => acc + (ch === "☆" ? 0.5 : ch === "★" ? 1 : 0), 0);
    if (currentLen >= 5) break;
    result += "✩";
    if ((result.match(/[★☆✩]/g) || []).length >= 5) break;
  }
  // 确保恰好5个字符
  const chars: string[] = result.match(/[★☆✩]/g) || [];
  while (chars.length < 5) { chars.push("✩"); result += "✩"; }
  return chars.slice(0, 5).join("");
}

/**
 * 四大师评分占位符 — 星级与评分由 Agent 基于调研基本面裁定
 * 本脚本仅输出财务数据框架，不自动评分
 */
function agentPlaceholderStars(): string {
  return "✩✩✩✩✩";
}
function agentPlaceholderScore(): string {
  return "_/10";
}

/** 计算股价在过去 N 日的历史分位（0-1） */
export function calculatePricePercentile(prices: number[], current: number): number {
  if (prices.length === 0) return 0;
  const sorted = [...prices].sort((a, b) => a - b);
  let below = 0;
  for (const p of sorted) {
    if (p <= current) below++;
    else break;
  }
  return below / sorted.length;
}

export async function generateFramework(
  thscode: string,
  peerCodes: string[] = [],
  companyType?: string,
  opts: { forwardGrowth?: number; scores?: Record<string, number> } = {},
) {
  const [snapshot, valuation, kline, inc, bal, cf, mcap] = await Promise.all([
    getSnapshot(thscode),
    getValuations(thscode),
    getKline(thscode, 250).catch(() => [] as Awaited<ReturnType<typeof getKline>>),
    getIncomeStatements(thscode, "annual", 4),
    getBalanceSheets(thscode, "annual", 4),
    getCashFlows(thscode, "annual", 4),
    getMarketCapFromEastmoney([thscode]).catch(() => []),
  ]);

  // 获取财务指标
  let indicators: Awaited<ReturnType<typeof getIndicators>> = [];
  if (inc.length > 0) {
    const fp = inc[0].fiscal_period;
    const fy = inc[0].fiscal_year;
    const map: Record<string, string> = { FY: "4", Q1: "1", Q2: "2", Q3: "3" };
    const report = `${fy}-${map[fp] ?? "4"}`;
    indicators = await getIndicators(thscode, report);
  }

  // 获取同业数据
  const peerData: {
    thscode: string;
    snapshot: Awaited<ReturnType<typeof getSnapshot>>;
    valuation: Awaited<ReturnType<typeof getValuations>>;
    indicators: Awaited<ReturnType<typeof getIndicators>>;
  }[] = [];
  for (const pc of peerCodes) {
    const pts = toThsCode(pc);
    const [ps, pv, pin] = await Promise.all([
      getSnapshot(pts).catch(() => [] as Awaited<ReturnType<typeof getSnapshot>>),
      getValuations(pts).catch(() => [] as Awaited<ReturnType<typeof getValuations>>),
      (async () => {
        const pinc = await getIncomeStatements(pts, "annual", 1).catch(() => []);
        if (pinc.length > 0) {
          const fp = pinc[0].fiscal_period;
          const fy = pinc[0].fiscal_year;
          const map: Record<string, string> = { FY: "4", Q1: "1", Q2: "2", Q3: "3" };
          const report = `${fy}-${map[fp] ?? "4"}`;
          return getIndicators(pts, report).catch(() => []);
        }
        return [];
      })(),
    ]);
    peerData.push({ thscode: pts, snapshot: ps, valuation: pv, indicators: pin });
  }

  const s = snapshot[0];
  const v = valuation[0];
  const ind = indicators[0];
  const latestInc = inc[0];
  const latestBal = bal[0];
  const latestCf = cf[0];

  // ==== 同比数据合理性校验（hithink API 同比偶发放大百倍，需以财报原文核对）====
  const yoyRevenue = ind?.yoy_operating_income ?? null;
  const yoyNetProfit = ind?.yoy_net_profit ?? null;
  const suspiciousYoy =
    (yoyRevenue !== null && Math.abs(yoyRevenue) > 5) ||
    (yoyNetProfit !== null && Math.abs(yoyNetProfit) > 5);
  const yoyAnomalyWarning = "⚠️ 同比数据存疑（|同比|>500%），请以财报原文核对";

  // ==== 一次性损益疑似检测（license-out/BD 首付款/资产处置等，PE-TTM 与 PEG 会失真）====
  const prevNetMargin = inc[1]?.operating_income != null && inc[1].operating_income > 0
    ? (inc[1].net_profit ?? 0) / inc[1].operating_income
    : null;
  const netMarginSpike = latestInc != null && latestInc.operating_income > 0 && prevNetMargin !== null && prevNetMargin > 0
    ? (latestInc.net_profit ?? 0) / latestInc.operating_income >= prevNetMargin * 2
    : false;
  const oneshotIncome = (yoyNetProfit !== null && yoyNetProfit > 3) || netMarginSpike;
  const oneshotWarning = "⚠️ 净利可能含大额一次性收入（BD/license-out/资产处置等），PE-TTM 与 PEG 失真，请用正常化盈利";

  // 计算股价历史分位（近250日）
  const closePrices = kline.map(k => k.close_price).filter(c => c > 0);
  const pricePercentile = s && closePrices.length > 0
    ? calculatePricePercentile(closePrices, s.last_price)
    : null;
  const priceMin250 = closePrices.length > 0 ? Math.min(...closePrices) : null;
  const priceMax250 = closePrices.length > 0 ? Math.max(...closePrices) : null;
  const priceMedian250 = closePrices.length > 0
    ? closePrices.sort((a, b) => a - b)[Math.floor(closePrices.length / 2)]
    : null;

  // ==== 市值 / TTM 净利 / Forward PE / 目标市值（估值追踪结构化字段的生产端）====
  const mcapItem = mcap[0];
  const marketCapYi = mcapItem?.market_cap != null ? mcapItem.market_cap / 1e8 : null;   // 总市值（亿元）
  const totalSharesYi = (marketCapYi != null && s?.last_price) ? marketCapYi / s.last_price : null; // 总股本（亿股）
  // TTM 净利 = 总市值 / PE-TTM（市值与估值同源时点）
  const ttmNetProfitYi = (marketCapYi != null && v?.pe_ttm != null && v.pe_ttm > 0)
    ? marketCapYi / v.pe_ttm
    : null;
  // 预测期增速：--forward-growth 优先，缺省取最新净利同比（周期股注意：用正常化增速而非当期）；
  // 同比数据存疑（|同比|>500%）时禁用自动递推，须显式 --forward-growth 才计算 Forward PE
  const forwardGrowth = opts.forwardGrowth ?? (suspiciousYoy ? null : ind?.yoy_net_profit ?? null);
  const baseYear = latestInc?.fiscal_year != null ? latestInc.fiscal_year + 1 : null;     // 基准期 = 最近年报财年 + 1
  const forwardNetProfitYi = (ttmNetProfitYi != null && forwardGrowth != null && forwardGrowth > -1)
    ? ttmNetProfitYi * (1 + forwardGrowth)
    : null;
  const forwardPe = (marketCapYi != null && forwardNetProfitYi != null && forwardNetProfitYi > 0)
    ? marketCapYi / forwardNetProfitYi
    : null;
  // 目标市值三情景（起步参考：当前 PE × 0.7 / 1.0 / 1.3，Agent 须按基本面修订）
  const peRef = v?.pe_ttm != null && v.pe_ttm > 0 ? v.pe_ttm : null;
  const targetCapRef = (pe: number) =>
    (forwardNetProfitYi != null && peRef != null) ? forwardNetProfitYi * peRef * pe : null;
  const targetCapPess = targetCapRef(0.7);
  const targetCapNeu = targetCapRef(1.0);
  const targetCapOpt = targetCapRef(1.3);
  const compositeScore = opts.scores ? computeComposite(opts.scores) : null;

  // 计算杜邦分析
  let dupont = { netMargin: null as number | null, assetTurnover: null as number | null, equityMultiplier: null as number | null, roe: null as number | null };
  if (latestInc && latestBal) {
    const netProfit = latestInc.net_profit ?? 0;
    const revenue = latestInc.operating_income ?? 0;
    const assets = latestBal.assets_total ?? 0;
    const equity = latestBal.holder_equity_total ?? 0;
    if (revenue > 0) dupont.netMargin = netProfit / revenue;
    if (assets > 0) dupont.assetTurnover = revenue / assets;
    if (equity > 0) dupont.equityMultiplier = assets / equity;
    if (equity > 0) dupont.roe = netProfit / equity;
  }

  // ==== 排雷数据生产端（供 quality-screen report 模式消费）====
  // 利息覆盖倍数 = 经营现金流 ÷ 利息支出
  const interestCoverage = latestCf && latestInc?.interest_expenses != null && latestInc.interest_expenses > 0
    ? (latestCf.act_cash_flow_net ?? 0) / latestInc.interest_expenses
    : null;
  // 应收账款同比增速（最近两期年报对比）
  const receivablesGrowth = bal.length >= 2
    && bal[0]?.accounts_receivable != null && bal[1]?.accounts_receivable != null && bal[1].accounts_receivable > 0
    ? (bal[0].accounts_receivable - bal[1].accounts_receivable) / bal[1].accounts_receivable
    : null;
  // 货币资金 / 总资产 占比（存贷双高判定输入）
  const cashAssetRatio = latestBal && latestBal.assets_total != null && latestBal.assets_total > 0 && latestBal.cash != null
    ? latestBal.cash / latestBal.assets_total
    : null;

  // 计算盈利质量信号
  const qualityFlags: { name: string; pass: boolean; detail: string; key?: string }[] = [];
  if (latestInc && latestCf) {
    const ocf = latestCf.act_cash_flow_net ?? 0;
    const netProfit = latestInc.net_profit ?? 0;
    qualityFlags.push({
      key: "ocf_vs_ni",
      name: "经营现金流 > 净利润",
      pass: ocf > netProfit,
      detail: `经营现金流 ${fmtWan(ocf)} vs 净利润 ${fmtWan(netProfit)}`,
    });
  }
  if (latestBal && latestInc) {
    const debt = latestBal.total_debt ?? 0;
    const assets = latestBal.assets_total ?? 1;
    qualityFlags.push({
      key: "debt_ratio",
      name: "资产负债率 < 70%",
      pass: (debt / assets) < 0.7,
      detail: `资产负债率 ${fmtPct(debt / assets)}`,
    });
  }
  if (ind) {
    qualityFlags.push({
      key: "roe",
      name: "ROE > 10%",
      pass: (ind.roe ?? 0) > 0.1,
      detail: `ROE ${fmtPct(ind.roe)}`,
    });
    qualityFlags.push({
      key: "gross_margin",
      name: "毛利率 > 20%",
      pass: (ind.gross_profit_ratio ?? 0) > 0.2,
      detail: `毛利率 ${fmtPct(ind.gross_profit_ratio)}`,
    });
  }
  // 以下三项需要多期财报 PDF 数据才能准确判断，单期 API 数据不足，标记为待人工补充
  qualityFlags.push({
    key: "revenue_trend",
    name: "营收趋势 ≥ 2 年连续稳健",
    pass: true, // 单期数据无法证伪，由人工后续补充
    detail: "仅单期数据，需查 3-5 年收入趋势确认是否连续稳健",
  });
  qualityFlags.push({
    key: "goodwill",
    name: "商誉 / 净资产 < 30%",
    pass: true, // 单期数据无商誉字段，由人工从财报 PDF 资产负债表确认
    detail: "同花顺 API 单期数据不含商誉明细，需从财报 PDF 资产负债表查商誉净额",
  });
  qualityFlags.push({
    key: "big_impairment",
    name: "无大额资产减值损失（≥ 净利 30%）",
    pass: true, // 单期数据无减值损失字段，由人工从财报 PDF 利润表确认
    detail: "同花顺 API 单期数据不含资产减值损失明细，需从财报 PDF 利润表查减值项",
  });

  // 输出 Markdown
  console.log(`# 四大师评估 + 财报精读框架：${thscode}\n`);

  // === 四大师星级评分卡（Agent 基于调研基本面裁定）===
  console.log(`## 四大师综合评分卡（Agent 裁定版）\n`);
  console.log(`> **说明**：以下星级与评分须由 Agent 基于护城河定性分析、管理层诚信核查、行业趋势判断、历史类比研究后**手动填写**，脚本不自动计算。\n`);
  console.log(`| 维度 | 大师 | 星级（1-5） | 0-10分 | 核心判断建议 |`);
  console.log(`|------|------|:----------:|:------:|---------|`);
  console.log(`| 能力圈 | 巴菲特 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：能否一句话说清生意本质？能否预测 10 年后格局？_ |`);
  console.log(`| 护城河 | 巴菲特 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：五类护城河（成本/品牌/网络/转换成本/规模/牌照）验证结果_ |`);
  console.log(`| 生意模式 | 段永平 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：怎么赚钱？现金流健康度？资本密集度？定价权？_ |`);
  console.log(`| 管理层诚信（本分） | 段永平 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：承诺兑现记录？关联交易？减持记录？资本配置能力？_ |`);
  console.log(`| 反向检查清单 | 芒格 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：失败情景？历史错误？财务地雷？竞争侵蚀？_ |`);
  console.log(`| 历史类比与时间框架 | 李录 | ${agentPlaceholderStars()} | ${agentPlaceholderScore()} | _由 Agent 填写：海外/历史类比？当前阶段？时间框架匹配度？_ |`);
  console.log(`| **综合** | — | **${agentPlaceholderStars()}** | **${agentPlaceholderScore()}** | **加权平均（六维各占 1/6）**|`);
  console.log(``);
  console.log(`> **星级说明**: ★ = 1 分（满分对应 10 分中的 10），☆ = 0.5 分，✩ = 0 分。5 星 = 顶级优秀（≥9 分），4 星 = 优秀（≥7.5 分），3 星 = 合格（≥6 分），2 星 = 存疑（≥4 分），1 星 = 不建议跟踪（<4 分）。`);
  console.log(``);

  // === 估值与股价快照 ===
  console.log(`## 估值与股价快照（数据来源：同花顺 hithink API）\n`);
  console.log(`| 指标 | 当前值 | 评价（建议 Agent 补充历史分位与同业对比） |`);
  console.log(`|------|--------|----------------------------------------|`);
  if (s && s.last_price !== null && s.last_price !== undefined) {
    const marketCap = s.last_price * 0; // 占位，需要总股本才能算，Agent 需补齐
    console.log(`| 最新股价（元） | ${s.last_price.toFixed(2)} | — |`);
  }
  if (snapshot.length > 0 && snapshot[0].turnover !== null) {
    console.log(`| 最新成交额 | ${fmtWan(snapshot[0].turnover)} | — |`);
  }
  if (v) {
    const peEval = v.pe_ttm === null ? "—" : v.pe_ttm > 50 ? "偏贵" : v.pe_ttm > 30 ? "略贵" : v.pe_ttm > 15 ? "合理" : v.pe_ttm > 0 ? "便宜" : "亏损";
    const peEvalFinal = oneshotIncome ? `${peEval}（疑似一次性损益，建议用正常化盈利）` : peEval;
    console.log(`| **PE-TTM** | ${v.pe_ttm?.toFixed(2) ?? "—"} | **${peEvalFinal}**（需结合行业历史分位与增速判断）${oneshotIncome ? " " + oneshotWarning : ""} |`);
    console.log(`| **PB-MRQ** | ${v.pb_mrq?.toFixed(2) ?? "—"} | — |`);
    console.log(`| PS-TTM | ${v.ps_ttm?.toFixed(2) ?? "—"} | — |`);
    console.log(`| PCF-TTM | ${v.pcf_ttm?.toFixed(2) ?? "—"} | — |`);
  }
  console.log(`| 数据时点 | ${fmtDate(Date.now())} | — |`);
  console.log(``);
  console.log(`> **估值判断（称重机视角）**：_由 Agent 填写：当前价格相对于内在价值处于什么位置？是否有安全边际？什么条件下会触发买入/卖出？_`);
  console.log("");

  // === 估值区间与目标价参考（自动计算 + Agent 填入假设）===
  const eps = latestInc?.basic_eps ?? null;
  console.log(`## 估值区间与目标价参考（安全边际视角）\n`);
  console.log(`> 以下「自动计算」部分由脚本基于同花顺 API 数据生成；「Agent 填入」部分须由 Agent 结合行业研究、历史估值、同业对比后填写合理假设。\n`);
  console.log(`| 指标 | 自动计算值 | 说明 |`);
  console.log(`|------|-----------|------|`);
  console.log(`| 当前股价 | ${s?.last_price?.toFixed(2) ?? "—"} 元 | — |`);
  console.log(`| 近250日股价区间 | ${priceMin250?.toFixed(2) ?? "—"} ~ ${priceMax250?.toFixed(2) ?? "—"} 元 | 最低 / 最高 |`);
  console.log(`| 近250日中位价 | ${priceMedian250?.toFixed(2) ?? "—"} 元 | — |`);
  console.log(`| 当前股价历史分位 | ${pricePercentile !== null ? (pricePercentile * 100).toFixed(1) + "%" : "—"} | 0%=近1年最低，100%=近1年最高 |`);
  console.log(`| EPS（基本，最近年报） | ${eps ?? "—"} 元/股 | 用于 PE 反推目标价 |`);
  console.log(`| PE-TTM | ${v?.pe_ttm?.toFixed(2) ?? "—"} | — |`);
  console.log(`| PB-MRQ | ${v?.pb_mrq?.toFixed(2) ?? "—"} | — |`);
  console.log("");

  // === 估值方法路由（企业类型 → 推荐近似路径）===
  console.log(`### 估值方法路由（企业类型 → 推荐近似路径）\n`);
  console.log(`> 估值方法论（参考《估值思想》）：乘数只是信息载体、不创造信息。须先判断企业类型，选择与价值创造机制匹配的近似路径，再反向检验倍数隐含假设。\n`);
  console.log(`| 企业类型 | 价值载体 | 推荐路径 | 关键警示 |`);
  console.log(`|---------|---------|---------|---------|`);
  console.log(`| 金融（银行/保险） | 净资产 | PB / 调整后净资产 | 净资产即未来经济利益近似，勿用 PE 硬套 |`);
  console.log(`| 周期（钢铁/化工/航运/大宗） | 穿越周期的平均盈利 | 正常化 EPS（5-10 年平均） | 繁荣期 PE-TTM 系统性低估、衰退期高估 |`);
  console.log(`| 资源（矿/油气） | 已探明储量 | 储量×(价格−成本) 按开采时间表折现 | 寿命有限，终值假设不适用 |`);
  console.log(`| 控股/多元集团 | 各板块独立价值 | 分部估值（SOTP） | 承认多元化折扣 |`);
  console.log(`| 一般工商 | 未来现金流 | PE/EV/EBITDA + 三变量拆解 | 须反向检验倍数隐含增长/回报/风险假设 |`);
  console.log(`\n> **当前标的判定**：${companyType ? `Agent 指定为「${companyType}」` : "未指定（可用 --type 指定，如 --type 周期）"}${eps !== null && eps < 0 ? "；EPS 为负 → 优先走 PB / 净资产路径" : ""}。周期行业若采用单年 PE-TTM，须同时给出正常化 EPS 对照。\n`);
  console.log("");

  console.log(`### 三情景目标价区间（Agent 填入合理假设后计算）\n`);
  console.log(`| 情景 | PE 假设（Agent 填） | 目标价 = EPS × PE | 隐含涨跌幅 |`);
  console.log(`|------|-------------------|------------------|-----------|`);
  console.log(`| 悲观 | __x | ${eps ? "__ 元" : "需先确认 EPS"} | __% |`);
  console.log(`| 中性 | __x | ${eps ? "__ 元" : "需先确认 EPS"} | __% |`);
