  // === 财报精读 10 项检查清单（ai-berkshire earnings-review 融入）===
  console.log(`## 财报精读 10 项检查清单（Earnings Review Checklist）\n`);
  console.log(`> 灵感来自 ai-berkshire/earnings-review Skill。以下自动检查项由财务数据触发，其余需 Agent 结合财报 MD&A 与审计意见手动打钩。\n`);
  console.log(`| # | 检查项 | 结果 | 详情/说明 |`);
  console.log(`|---|--------|------|-----------|`);
  // 自动检查项
  const erPass = (b: boolean) => b ? "✅" : "❌";
  const erWarn = (b: boolean) => b ? "⚠️" : "✅";
  const er1 = ind?.roe !== null && ind?.roe !== undefined ? ind.roe >= 0.12 : null;
  const er2 = (latestCf && latestInc?.net_profit !== null && latestInc?.net_profit !== undefined && latestInc.net_profit !== 0)
    ? (latestCf.act_cash_flow_net ?? 0) / latestInc.net_profit >= 0.8
    : null;
  const er3 = ind?.asset_liability_ratio !== null && ind?.asset_liability_ratio !== undefined ? ind.asset_liability_ratio <= 0.6 : null;
  const er4 = latestInc?.parent_holder_net_profit !== null && latestInc?.parent_holder_net_profit !== undefined ? latestInc.parent_holder_net_profit > 0 : null;
  const er5 = ind?.gross_profit_ratio !== null && ind?.gross_profit_ratio !== undefined ? ind.gross_profit_ratio >= 0.25 : null;
  // er6~er8 需要多期财报 PDF 或资产负债表明细字段，单期 API 数据不足，标记为 null（待人工）
  const er6: boolean | null = null;   // 营收趋势需 3-5 年收入数据
  const er7: boolean | null = null;   // 商誉/净资产需资产负债表商誉明细
  const er8: boolean | null = null;   // 大额减值需利润表资产减值损失明细
  // 9,10 为定性项，留空手动填
  const fmtAuto = (r: boolean | null, detailYes: string, detailNo = "", warn = false) => {
