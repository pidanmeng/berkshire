  const pegNote = peg === null ? "数据不足" : peg > 2 ? "偏高（隐含增长/回报假设偏乐观）" : peg < 1 ? "有吸引力（隐含假设保守）" : "基本匹配";
  console.log(`### 倍数隐含假设反推（三变量：规模 / 时间 / 风险）\n`);
  console.log(`> 乘数不创造信息，只是信息载体。对当前 PE 回答三问：隐含了多高的增长？多长的持续期？多大的风险折价？并与基本面数据比对。\n`);
  console.log(`| 反推项 | 自动计算 | 判读 |`);
  console.log(`|--------|---------|------|`);
  console.log(`| PEG（PE ÷ 净利增速%） | ${peg !== null ? peg.toFixed(2) : "—"}${suspiciousYoy ? "（同比存疑，PEG 不可用）" : ""} | ${pegNote}（PEG>2 偏贵 / <1 有吸引力）${oneshotIncome ? " " + oneshotWarning : ""} |`);
  console.log(`| PE-TTM vs 净利同比 | ${v?.pe_ttm?.toFixed(2) ?? "—"} vs ${fmtPct(netGrowth)}${suspiciousYoy ? "（⚠️ 同比存疑，以年报为准）" : ""} | ${netGrowth != null && netGrowth > 0 && v?.pe_ttm != null && !suspiciousYoy ? (v.pe_ttm < netGrowth * 100 ? "倍数低于增速，称重偏轻" : v.pe_ttm > netGrowth * 100 * 2 ? "倍数显著高于增速，隐含假设乐观" : "倍数与增速基本匹配") : "数据不足或存疑"} |`);
  console.log(`\n> 注意：周期股当期净利增速不代表穿越周期盈利，勿直接用 PEG/增速反推隐含假设，改用正常化盈利。\n`);
  console.log("");

  console.log(`> **Agent 填表指引（估值思想 · 六步框架）**：`);
