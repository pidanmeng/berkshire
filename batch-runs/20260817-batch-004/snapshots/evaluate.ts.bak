    return `${r ? "✅" : (warn ? "⚠️" : "❌")} | ${r ? detailYes : detailNo}`;
  };
  console.log(`| 1 | ROE ≥ 12%（资本回报达标） | ${fmtAuto(er1, "达标", "未达 12% 良好线，资本回报偏低")}`);
  console.log(`| 2 | 经营现金流 ≥ 净利润 × 0.8（利润含金） | ${latestCf && latestInc?.net_profit ? fmtAuto(er2, `OCF/NI=${((latestCf.act_cash_flow_net ?? 0) / latestInc.net_profit).toFixed(2)} ≥ 0.8 ✅`, `OCF/NI=${((latestCf.act_cash_flow_net ?? 0) / latestInc.net_profit).toFixed(2)} < 0.8，利润含金量存疑`, true) : "🟡 待补充 | 无现金流量表/利润表数据"}`);
  console.log(`| 3 | 资产负债率 ≤ 60%（杠杆可控，非金融行业） | ${fmtAuto(er3, `≤ 60%`, `> 60%，杠杆偏高，需判断行业属性`)}`);
  console.log(`| 4 | 当期归母净利润为正（盈利状态） | ${fmtAuto(er4, "盈利中", "亏损状态")}`);
  console.log(`| 5 | 毛利率 ≥ 25%（差异化/护城河信号） | ${fmtAuto(er5, `≥ 25% 差异化可能`, `< 25% 同质化/价格战风险`, true)}`);
  console.log(`| 6 | 营收趋势 ≥ 2 年连续稳健（非 1 年昙花） | ${er6 === null ? "🟡 待补充 | 需查 3-5 年收入趋势" : `${erPass(er6)} | ${qualityFlags.find(f => f.key === "revenue_trend")?.detail ?? ""}`}`);
  console.log(`| 7 | 商誉 / 净资产 < 30%（减值地雷风险低） | ${er7 === null ? "🟡 待补充 | 需从资产负债表查商誉净额" : `${erPass(er7)} | ${qualityFlags.find(f => f.key === "goodwill")?.detail ?? ""}`}`);
  console.log(`| 8 | 无大额资产减值损失（≥ 净利 30%） | ${er8 === null ? "🟡 待补充 | 需查利润表资产减值损失项" : `${erPass(er8)} | ${qualityFlags.find(f => f.key === "big_impairment")?.detail ?? ""}`}`);
  console.log(`| 9 | 审计意见为「标准无保留」 | ⬜️ **待人工** | 直接下载财报 PDF 首页审计意见查看 |`);
  console.log(`| 10 | MD&A「未来展望」无重大风险提示隐瞒 | ⬜️ **待人工** | 阅读年报管理层讨论分析章节，警惕「前瞻性陈述」过度乐观/隐瞒 |`);
  console.log("");
