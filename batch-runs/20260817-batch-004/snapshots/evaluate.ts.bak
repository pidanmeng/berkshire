async function main() {
  const args = process.argv.slice(2);
  const codeIdx = args.indexOf("--code");
  if (codeIdx < 0) {
    console.log(`
四大师评估 + 财报精读框架生成器

用法:
  bun run evaluate.ts --code 600519
  bun run evaluate.ts --code 600519 --peer 000858 --peer 000568
  bun run evaluate.ts --code 600519 --type 周期            # 企业类型: 金融/周期/资源/控股集团/一般工商
  bun run evaluate.ts --code 600519 --forward-growth 0.25  # 预测期净利增速（缺省取最新净利同比）
  bun run evaluate.ts --code 600519 --scores capability=6.5,moat=7.0,business_model=5.5,management=6.0,inversion=6.5,historical=6.0  # 预览综合分
`);
    process.exit(1);
  }
  const code = args[codeIdx + 1];
  const thscode = toThsCode(code);
  const peerCodes: string[] = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--peer" && args[i + 1]) {
      peerCodes.push(args[i + 1]);
    }
  }
  const typeIdx = args.indexOf("--type");
  const companyType = typeIdx >= 0 ? args[typeIdx + 1] : undefined;
  // --forward-growth 0.25
  let forwardGrowth: number | undefined;
  const fgIdx = args.indexOf("--forward-growth");
  if (fgIdx >= 0 && args[fgIdx + 1]) {
    const g = parseFloat(args[fgIdx + 1]);
    if (!Number.isNaN(g)) forwardGrowth = g;
  }
  // --scores capability=6.5,moat=7.0,...
  let scores: Record<string, number> | undefined;
  const scIdx = args.indexOf("--scores");
  if (scIdx >= 0 && args[scIdx + 1]) {
    scores = {};
    for (const pair of args[scIdx + 1].split(",")) {
      const [k, v] = pair.split("=");
      if (k && v !== undefined) {
        const n = parseFloat(v);
        if (!Number.isNaN(n)) scores[k.trim()] = n;
      }
    }
  }
  await generateFramework(thscode, peerCodes, companyType, { forwardGrowth, scores });
}

if (import.meta.main) main().catch(err => { console.error(`❌ ${err.message}`); process.exit(1); });
export { main };
