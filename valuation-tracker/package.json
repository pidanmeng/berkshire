{
  "name": "valuation-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun run --watch server/index.ts",
    "dev:web": "bun ./node_modules/next/dist/bin/next dev -p 3000",
    "sync-data": "bun run scripts/build-research-db.ts",
    "sync-data:remote": "bun run scripts/build-research-db.ts --remote",
    "build": "bun run sync-data:remote && bun ./node_modules/next/dist/bin/next build",
    "start": "bun ./node_modules/next/dist/bin/next start -p 3000",
    "server": "bun run server/index.ts",
    "snapshot": "bun run scripts/snapshot.ts",
    "deploy": "npx vercel --prod",
    "deploy:preview": "npx vercel"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@libsql/client": "^0.14.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^5.5.1",
    "elysia": "^1.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "next": "^15.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
