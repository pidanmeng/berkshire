# ===== 前端（Next.js）=====
# Elysia 后端地址。前后端一体部署（Vercel / 本地 dev）时留空（同域相对路径 /api）；
# 若后端单独部署（如自托管 3001），填线上地址，如 https://api.example.com
API_BASE_URL=

# 客户端组件访问后端地址（构建期内联；单独部署时才需要显式指定）
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ===== 后端（Elysia）=====
# 同花顺 API Key（与根仓库 hithink.ts 优先级链一致；不设则用脚本内置 key）
HITHINK_FINANCE_API_KEY=

# ===== 前端（浏览器直连，一期可选）=====
# 同花顺估值补充 API Key：浏览器直连 fuyao.aicubes.cn 用（构建期内联进前端产物）。
# 一期本地测试可填（与 HITHINK_FINANCE_API_KEY 同值）；正式使用建议二期改为用户在页面
# 设置（localStorage['hithink-api-key'] 优先于本变量）。不配置时前端仅用东财直连
# 行情/市值/K线，估值字段（PE/PB/PS/PCF）留空展示 —。
# NEXT_PUBLIC_HITHINK_API_KEY=

# 调研知识库根目录：
#  - 本地开发：默认仓库根（../，读真实 Research/）
#  - Vercel Serverless：RESEARCH_DATA_DIR 指向构建期打包进函数的数据副本（默认 research-data，可留空）
RESEARCH_ROOT=
# RESEARCH_DATA_DIR=research-data

# Elysia 监听端口（默认 3001，仅 Bun 自托管模式使用）
PORT=3001

# CORS 允许来源（逗号分隔；前后端一体部署时无需设置）
# CORS_ORIGIN=https://your-app.vercel.app

# 留言板管理员密码（不配置则管理员登录禁用；正式部署必须设置，建议使用强随机串）
ADMIN_TOKEN=

# ===== 可选：Turso（Vercel Serverless 持久化动态状态，价格快照/基本面检测缓存）=====
# 本地/Bun 自托管默认优先本地 SQLite（data/tracker.db）；Turso 仅在 Vercel（VERCEL 环境）、
# 本地文件系统不可用或显式设置 FORCE_TURSO=1 时启用。
# 不配置时降级为内存存储（每次冷启动丢失，功能可用但不持久）
# FORCE_TURSO=1
# TURSO_URL=libsql://xxx.turso.io
# TURSO_AUTH_TOKEN=eyJ...
